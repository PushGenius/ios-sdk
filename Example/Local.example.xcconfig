// Copy to Local.xcconfig and fill in.

// Must match the bundle ID saved in the dashboard under Settings → iOS, and be unique to your team.
PG_BUNDLE_ID = com.example.pushgenius-test
// Your Apple Developer team ID (Xcode → Settings → Accounts).
DEVELOPMENT_TEAM = ABCDE12345
// Dashboard → Settings.
PUSHGENIUS_APP_ID = 00000000-0000-0000-0000-000000000000

// Optional: a local backend. xcconfig treats // as a comment, so write the scheme as http:/$()/
// PUSHGENIUS_HOST = http:/$()/192.168.1.10:3001
